{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "frontend": {
      "root": "aulas/aula-04/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/aula-04",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/aula-04/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
